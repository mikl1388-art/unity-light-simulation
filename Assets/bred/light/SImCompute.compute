// ReSharper disable CppInconsistentNaming

#define THREADS 16

#pragma region CSMain
#pragma kernel CSMain

struct CellData
{
    float4 pos;
    float4 vel;
    float mass;
    float isValid;
};

StructuredBuffer<CellData> _Input;
RWStructuredBuffer<CellData> _Output;
RWStructuredBuffer<float4> _CumulativeBuffer;

int2 _FieldSize;
float _Stiffness;
float _DeltaTime;
float4 _ColorCoef;
float _CumulativeRatio;

#define NEI_COUNT 4
#define BORDER 32.0
#define ABSORPTION_STR 0.25

int Idx(uint2 id)
{
    return id.y * _FieldSize.x + id.x;
}

CellData GetNeighborData(int2 coord)
{
    float inside = step(0, coord.x) * step(coord.x, _FieldSize.x - 1) *
                   step(0, coord.y) * step(coord.y, _FieldSize.y - 1);
    
    int2 clampedCoord = clamp(coord, int2(0, 0), _FieldSize - 1);
    CellData data = _Input[Idx(clampedCoord)];
    data.mass = 1.0; 
    data.isValid = inside;
    return data;
}

[numthreads(THREADS, THREADS, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    if ((int) id.x >= _FieldSize.x || (int) id.y >= _FieldSize.y)
        return;
    
    CellData cur = _Input[Idx(id.xy)];
    CellData newCell = cur;
    
    
    _CumulativeBuffer[Idx(id.xy)] = float4(cur.pos.rgb, cur.mass);
    //_CumulativeBuffer[Idx(id.xy)] += float4(max(cur.pos.rgb, 0) * _CumulativeRatio, cur.mass);
    
    float isWave = step(0, cur.mass);
    
    int2 offsets[NEI_COUNT] = { int2(-1, 0), int2(1, 0), int2(0, -1), int2(0, 1) };
    
    for (int i = 0; i < NEI_COUNT; i++)
    {
        CellData neighbor = GetNeighborData(int2(id.xy) + offsets[i]);
        
        float4 deltaPos = neighbor.pos - cur.pos;
        newCell.vel += ((deltaPos * _Stiffness) / (pow(max(1e-6, cur.mass), _ColorCoef))) * _DeltaTime * neighbor.isValid;
    }

    uint distToEdgeX = min(id.x, (uint) _FieldSize.x - 1 - id.x);
    uint distToEdgeY = min(id.y, (uint) _FieldSize.y - 1 - id.y);
    float minDist = (float) min(distToEdgeX, distToEdgeY);
    float normalizedDist = saturate(1.0 - (minDist / BORDER));
    float dampingFactor = 1.0 - (normalizedDist * normalizedDist * ABSORPTION_STR);
    newCell.vel *= saturate(dampingFactor);
    
    newCell.pos += newCell.vel * _DeltaTime;
    
    newCell.pos = lerp(cur.pos, newCell.pos, isWave);
    newCell.vel = lerp(cur.vel, newCell.vel, isWave);
    
    _Output[Idx(id.xy)] = newCell;
}
#pragma endregion

#pragma region CSAccum
#pragma kernel CSAccum

RWTexture2D<float4> _CumulativeTexture;

[numthreads(THREADS, THREADS, 1)]
void CSAccum(uint3 id : SV_DispatchThreadID)
{
    if ((int) id.x >= _FieldSize.x || (int) id.y >= _FieldSize.y)
        return;
    
    CellData cur = _Output[Idx(id.xy)];
    _CumulativeTexture[id.xy] = _CumulativeBuffer[Idx(id.xy)];
}
#pragma endregion

#pragma region CSInit
#pragma kernel CSInit

RWStructuredBuffer<CellData> _OutputBuffer;
float Seed;

#pragma region CSInitFunctions
// Простая хэш-функция для генерации псевдослучайного числа [0.0 - 1.0]
float Hash21(float2 p)
{
    p = frac(p * float2(123.34, 456.21));
    p += dot(p, p + 45.32);
    return frac(p.x * p.y);
}

// Маски по-прежнему возвращают float (0.0 или 1.0)
float getCircleMask(uint x, uint y, float x0, float y0, float R)
{
    float dx = (float) x - x0;
    float dy = (float) y - y0;
    return step(dx * dx + dy * dy, R * R);
}

float getRectangleMask(uint x, uint y, float x0, float y0, float width, float height)
{
    float fx = (float) x;
    float fy = (float) y;
    return step(x0, fx) * step(fx, x0 + width - 1.0) * step(y0, fy) * step(fy, y0 + height - 1.0);
}

// Теперь эти функции принимают и модифицируют структуру CellData
// Обрати внимание: pos здесь — это float3. Передаем значение в нужную ось, например, в X
void addCircle(uint3 id, float x0, float y0, float R, float4 pos, float mass, inout CellData result)
{
    float mask = getCircleMask(id.x, id.y, x0, y0, R);
    
    // Плавное переключение всей структуры по маске
    result.pos = lerp(result.pos, pos, mask);
    result.mass = lerp(result.mass, mass, mask);
}

void addRectangle(uint3 id, float x0, float y0, float width, float height, float4 pos, float mass, inout CellData result)
{
    float mask = getRectangleMask(id.x, id.y, x0, y0, width, height);
    
    result.pos = lerp(result.pos, pos, mask);
    result.mass = lerp(result.mass, mass, mask);
}

float edgeSide(float2 p, float2 a, float2 b)
{
    return (p.x - a.x) * (b.y - a.y) - (p.y - a.y) * (b.x - a.x);
}

float getTriangleMask(uint x, uint y, float2 v1, float2 v2, float2 v3)
{
    float2 p = float2((float) x, (float) y);

    // Вычисляем положение пикселя относительно каждого из трех ребер
    float s1 = edgeSide(p, v1, v2);
    float s2 = edgeSide(p, v2, v3);
    float s3 = edgeSide(p, v3, v1);

    // Проверяем, что знак одинаковый для всех трех ребер (ориентация по или против часовой)
    // step(0.0, s) вернет 1.0, если точка "слева" или на ребре
    float has_neg = step(s1, 0.0) * step(s2, 0.0) * step(s3, 0.0);
    float has_pos = step(0.0, s1) * step(0.0, s2) * step(0.0, s3);

    // Если либо все плюсы, либо все минусы — пиксель внутри. 
    // max() работает как логическое ИЛИ (поскольку значения 0.0 или 1.0)
    return max(has_neg, has_pos);
}

void addTriangle(uint3 id, float2 v1, float2 v2, float2 v3, float4 pos, float mass, inout CellData result)
{
    float mask = getTriangleMask(id.x, id.y, v1, v2, v3);
    
    result.pos = lerp(result.pos, pos, mask);
    result.mass = lerp(result.mass, mass, mask);
}

void addLightBeam(uint3 id, float2 origin, float2 dir, float width, float lenght, float freq, inout CellData result)
{
    float2 p = float2((float) id.x, (float) id.y);
    
    float2 N = normalize(dir);
    float2 tangent = float2(-N.y, N.x);
    
    // Проекция точки на ось луча (расстояние вдоль луча)
    float distanceAlong = dot(p - origin, N);
    // Проекция точки поперек луча (расстояние от центральной линии луча)
    float distanceAcross = dot(p - origin, tangent);
    
    // 1. Маска ширины луча (ограничиваем луч по бокам плавным затуханием)
    // Используем гладкий шаг smoothstep вместо жесткого step, чтобы не было "зубцов"
    float edgeMask = smoothstep(width, width - 5.0, abs(distanceAcross));
    
    // Ограничиваем луч сзади (чтобы он не светил назад из источника)
    float behindMask = step(0.0, distanceAlong);
    float forwardMask = step(distanceAlong, lenght);
    float finalMask = edgeMask * forwardMask * behindMask;
    
    // 2. Сама волна (синусоида)
    // Форма позиции: синус от расстояния вдоль луча
    float wavePos = sin(distanceAlong * freq);
    
    // Начальная скорость: косинус (производная синуса), завязанный на направление.
    // Именно этот косинус заставит волну ЛЕТЕТЬ вперед, а не просто стоять и пульсировать!
    float waveVel = -cos(distanceAlong * freq) * freq;
    
    // Плавное смешивание (накладываем пучок поверх того, что уже было в буфере)
    result.pos = lerp(result.pos, wavePos, finalMask);
    result.vel = lerp(result.vel, waveVel, finalMask);
    
    result.mass = 1.0;
}

void addGaussianBeam(uint3 id, float2 origin, float2 dir, float width, float length, float freq, float waveSpeed, inout CellData result)
{
    float2 p = float2((float) id.x, (float) id.y);
    float2 N = normalize(dir);
    float2 tangent = float2(-N.y, N.x);
    
    float2 toCell = p - origin;
    float distanceAlong = dot(toCell, N);
    float distanceAcross = dot(toCell, tangent);
    
    // 1. Поперечный профиль луча (ФУНКЦИЯ ГАУССА)
    // Никаких косинусов! Только плавное спадание энергии от центра к краям.
    // Это гарантирует, что луч не будет фонить в стороны "шахматкой".
    float crossProfile = exp(-(distanceAcross * distanceAcross) / (width * width));
    
    // 2. Продольный профиль (Ограничиваем пучок спереди и сзади)
    float longProfile = exp(-(distanceAlong * distanceAlong) / (length * length));
    
    // Итоговая маска (форма "таблетки" или лазерного сгустка)
    float envelope = crossProfile * longProfile;
    
    // 3. Сама волна внутри сгустка
    float phase = distanceAlong * freq;
    float wavePos = sin(phase);
    
    // 4. СКОРОСТЬ (Магия направленности)
    // Чтобы волна летела ТОЛЬКО вперед, начальная скорость должна быть равна:
    // минус производная фазы, умноженная на физическую скорость волны в среде (c).
    float waveVel = -cos(phase) * freq * waveSpeed;
    
    // Накладываем результат (домножаем на envelope, чтобы края сгустка сошли на нет)
    result.pos += wavePos * envelope;
    result.vel += waveVel * envelope;
    
    // Делаем среду стабильной внутри луча
    result.mass = 1.0;
}

void addLens1(uint3 id, float2 center, float R, float thickness, float power, inout CellData result)
{
    float2 p = float2((float) id.x, (float) id.y);
    
    // Вычисляем центры двух сфер, которые при пересечении образуют линзу
    // Сферы смещены влево и вправо от центра линзы
    float offset = R - (thickness * 0.5);
    float2 centerLeft = center - float2(offset, 0.0);
    float2 centerRight = center + float2(offset, 0.0);
    
    // Расстояние от текущей ячейки до центров этих сфер
    float distToLeft = distance(p, centerLeft);
    float distToRight = distance(p, centerRight);
    
    // Если ячейка находится И внутри левой сферы, И внутри правой сферы — она внутри линзы!
    // (Для рассеивающей линзы знак инвертируется, но пока сделаем классическую собирающую)
    if (distToLeft < R && distToRight < R)
    {
        // Считаем плавное сглаживание краев линзы (антиалиасинг), чтобы не было ступенек
        float edgeLeft = smoothstep(R, R - 1.0, distToLeft);
        float edgeRight = smoothstep(R, R - 1.0, distToRight);
        float lensMask = edgeLeft * edgeRight;
        
        // Изменяем массу среды (коэффициент преломления). 
        // Чем больше масса, тем медленнее идет волна -> тем сильнее преломление.
        // power = 1.0 означает обычную среду, power = 2.0 — среда в 2 раза плотнее.
        result.mass = lerp(result.mass, power, lensMask);
    }
}

void addConvexLens(uint3 id, float2 center, float height, float focus, inout CellData result)
{
    float2 p = float2((float) id.x, (float) id.y);
    float n = 3.0; // Твой коэффициент преломления
    
    // 1. Считаем честный радиус сфер по твоей формуле
    float R = 2.0 * (n - 1.0) * focus;
    
    // Половина высоты линзы (апертура)
    float h = height * 0.5;
    
    R = max(R, h + 0.01);
    
    // 2. Ищем толщину половинки линзы (стрелу сегмента s), используя половину высоты h
    float s = R - sqrt(R * R - h * h);
    
    // Находим смещение центров сфер относительно центра линзы
    float offset = R - s; // В исходной формуле для полной толщины (2*s) offset = R - (2*s * 0.5), что равно R - s
    float2 centerLeft = center - float2(offset, 0.0);
    float2 centerRight = center + float2(offset, 0.0);
    
    // Проверяем попадание ячейки внутрь линзы
    float distToLeft = distance(p, centerLeft);
    float distToRight = distance(p, centerRight);
    
    if (distToLeft < R && distToRight < R)
    {
        // Плавное сглаживание краев пикселей
        float edgeLeft = smoothstep(R, R - 1.2, distToLeft);
        float edgeRight = smoothstep(R, R - 1.2, distToRight);
        float lensMask = edgeLeft * edgeRight;
        
        result.mass = lerp(result.mass, n, lensMask);
    }
}

void addAsphericLens(uint3 id, float2 center, float height, float focus, inout CellData result)
{
        
    float2 p = float2((float) id.x, (float) id.y);
    float n = 2.0; // Коэффициент преломления
    
    float dx = p.x - center.x;
    float dy = p.y - center.y;
    
    float halfHeight = height * 0.5;
    if (abs(dy) > halfHeight)
        return;
    
    float f_side = focus * 2.0;
    float k = n / (n + 1.0);
    
    // 2. ИСПРАВЛЕНИЕ ГЕОМЕТРИИ ЛИНЗЫ
    // Формула гиперболы дает "стрелу прогиба" (sagitta) — отклонение от плоской поверхности.
    // В центре (dy = 0) sagitta равна 0, на краях — максимальна.
    float sagitta = sqrt(f_side * f_side + (dy * dy) * k) - f_side;
    
    // Вычисляем максимальный прогиб на краю линзы
    float maxSagitta = sqrt(f_side * f_side + (halfHeight * halfHeight) * k) - f_side;
    
    // Чтобы линза была ВЫПУКЛОЙ (толстой в центре и острой по краям),
    // нужно из максимальной толщины вычесть текущий прогиб.
    float halfThickness = maxSagitta - sagitta;
    
    // Добавляем минимальную базовую толщину (например, 1 пиксель), 
    // чтобы края линзы не исчезали полностью из-за погрешностей сетки
    halfThickness += 1.0;
    
    // Проверяем, находится ли пиксель внутри линзы
    float distToEdge = halfThickness - abs(dx);
    
    if (distToEdge > 0.0)
    {
        // Сглаживание по профилю линзы и на торцах
        float edgeX = smoothstep(0.0, 1.2, distToEdge);
        float edgeY = smoothstep(halfHeight, halfHeight - 1.2, abs(dy));
        float lensMask = edgeX * edgeY;
        
        result.mass = lerp(result.mass, n, lensMask);
    }
}

void addConcaveLens(uint3 id, float2 center, float height, float focus, inout CellData result)
{
        
    float2 p = float2((float) id.x, (float) id.y);
    float n = 2.0; // Коэффициент преломления
    
    float dx = p.x - center.x;
    float dy = p.y - center.y;
    
    float halfHeight = height * 0.5;
    if (abs(dy) > halfHeight)
        return;
    
    // Мнимый фокус для каждой из сторон
    float f_side = focus * 2.0;
    float k = n / (n + 1.0);
    
    // Вычисляем прогиб гиперболы (сагитту). В центре (dy=0) она равна 0.
    float sagitta = sqrt(f_side * f_side + (dy * dy) * k) - f_side;
    
    // Для вогнутой линзы sagitta — это и есть наша полутолщина!
    // В самом центре линза будет иметь толщину baseThickness.
    float baseThickness = 10.0; // Минимальная толщина в центре (в пикселях)
    float halfThickness = sagitta + baseThickness;
    
    // Проверяем, находится ли пиксель внутри линзы по горизонтали
    float distToEdge = halfThickness - abs(dx);
    
    if (distToEdge > 0.0)
    {
        // Сглаживание по профилю (X) и на торцах (Y)
        float edgeX = smoothstep(0.0, 1.2, distToEdge);
        float edgeY = smoothstep(halfHeight, halfHeight - 1.2, abs(dy));
        float lensMask = edgeX * edgeY;
        
        result.mass = lerp(result.mass, n, lensMask);
    }
}

void addParabolicMirror(uint3 id, float2 center, float size, float focus, float thickness, float angle, inout CellData result)
{        
    float2 p = float2((float) id.x, (float) id.y);
    
    float dx = p.x - center.x;
    float dy = p.y - center.y;
    
    float rad = radians(angle);
    float cosA = cos(rad);
    float sinA = sin(rad);
    
    float rotX = dx * cosA + dy * sinA;
    float rotY = -dx * sinA + dy * cosA;
    
    float halfSize = size * 0.5;
    if (abs(rotY) > halfSize)
        return;
        
    // 5. Уравнение параболы в повернутых координатах
    // Ветви по-прежнему смотрят "навстречу" локальной оси X
    float targetX = -(rotY * rotY) / (4.0 * focus);
    
    // 6. Расстояние от пикселя до кривой параболы по повернутой оси X
    float distToCurve = abs(rotX - targetX);
    
    // 7. Проверяем попадание пикселя в толщину
    float halfThickness = thickness * 0.5;
    
    if (distToCurve <= halfThickness)
    {
        result.mass = -1.0;
    }
}

#pragma endregion

[numthreads(THREADS, THREADS, 1)]
void CSInit(uint3 id : SV_DispatchThreadID)
{
    // Безопасное отсечение по размеру буфера
    if ((int) id.x >= _FieldSize.x || (int) id.y >= _FieldSize.y)
        return;

    float randomVal = Hash21(id.xy + Seed);
    
    // Инициализируем дефолтную ячейку (по умолчанию mass = 1.0)
    CellData currentCell;
    currentCell.pos = float4(0.0, 0.0, 0.0, 0.0);
    currentCell.vel = float4(0.0, 0.0, 0.0, 0.0);
    currentCell.mass = 1.0;
    currentCell.isValid = 1.0; // Изначально ячейка валидна
    
    float X = _FieldSize.x;
    float Y = _FieldSize.y;
    
    float halfX = X * 0.5;
    float halfY = Y * 0.5;
    float cirX = halfX * 0.5;
    float cirY = halfY;
    
    //addGaussianBeam(id, float2(X * 0.25, Y * 0.25), float2(1, 0), max(5, 0.03 * Y), max(5, 0.03 * Y), 0.5, 1, currentCell);
    //addCircle(id, halfX, halfY, 0.25 * X, float4(0, 0, 0, 0), 2, currentCell);
    
    //addRectangle(id, 0.25 * X, 0.4 * Y, max(1, 0.002 * X), 0.2 * Y, float4(1.0, 1.0, 1.0, 0.0), 1.0, currentCell);
    
    float gap = max(0.009 * X, 1);
    float spacer = max(2, 0.045);
    
    /*addRectangle(id, 0.27 * X, Y * 0.5 * spacer + gap, 3.0, (float) _FieldSize.y, float4(0, 0, 0, 0), -1.0, currentCell);
    addRectangle(id, 0.27 * X0, 0.0, 3.0, Y * 0.5 - 0.5 * spacer - gap, float4(0, 0, 0, 0), -1.0, currentCell);
    addRectangle(id, 0.27 * X, Y * 0.5 - 0.5 * spacer, 3.0, spacer, float4(0, 0, 0, 0), -1.0, currentCell);*/
    
    //addGaussianBeam(id, float2(0.1 * X, 0.5 * Y), float2(1, 0), max(5, 0.045 * Y), max(5, 0.045 * Y), 0.5, 1, currentCell);
    //addTriangle(id, float2(0.30 * X, 0.3 * Y), float2(0.6 * X, 0.3 * Y), float2(0.45 * X, 0.8 * Y), float4(0, 0, 0, 0), 2, currentCell);
    //addConcaveLens(id, float2(0.45 * X, halfY), Y * 0.3, Y * 0.25, currentCell);
    
    addGaussianBeam(id, float2(0.1 * X, 0.5 * Y), float2(1, 0), max(5, 0.1 * Y), max(5, 0.1 * Y), 0.5, 1, currentCell);
    addAsphericLens(id, float2(0.4 * X, 0.5 * Y), Y * 0.5, Y * 0.1, currentCell);
    //addParabolicMirror(id, float2(halfX, halfY), Y * 0.3, Y * 0.15, 5, 45, currentCell);

    _OutputBuffer[Idx(id.xy)] = currentCell;
}
#pragma endregion

#pragma kernel CSFindBounds

Texture2D<float4> SourceTexture;
RWStructuredBuffer<int> boundsBuffer;

[numthreads(THREADS, THREADS, 1)]
void CSFindBounds(uint3 id : SV_DispatchThreadID)
{
    float val = SourceTexture[id.xy].r;
    
    // Переводим во временный int для атомарной операции (умножаем на точность)
    int intVal = (int) (val * 1000.0f);

    // Безопасное параллельное сравнение по всей видеокарте
    InterlockedMin(boundsBuffer[0], intVal);
    InterlockedMax(boundsBuffer[1], intVal);
}