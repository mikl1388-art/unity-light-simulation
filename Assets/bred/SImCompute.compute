#pragma kernel CSMain

Texture2D<float4> _Input;
RWTexture2D<float4> _Output;
RWTexture2D<float4> _Cumulative;

int2 _FieldSize;
float _Stiffness;
float _DeltaTime;
float _CumulativeRatio;

#define NEI_COUNT 4
#define BORDER 16.0
#define ABSORPTION_STR 0.25

void GetNeighborsFN(uint2 id, out float4 neighbors[4])
{
    int width = _FieldSize.x;
    int height = _FieldSize.y;
    int x = (int) id.x;
    int y = (int) id.y;

    // Вычисляем смещения координат
    int leftX = x - 1;
    int rightX = x + 1;
    int downY = y - 1;
    int upY = y + 1;

    // Проверяем границы и сразу упаковываем: xyz = данные, w = валидность (1 или 0)
    neighbors[0] = (leftX >= 0) ? float4(_Input[uint2(leftX, y)].xyz, 1.0) : float4(0, 0, 0, 0.0);
    neighbors[1] = (rightX < width) ? float4(_Input[uint2(rightX, y)].xyz, 1.0) : float4(0, 0, 0, 0.0);
    neighbors[2] = (downY >= 0) ? float4(_Input[uint2(x, downY)].xyz, 1.0) : float4(0, 0, 0, 0.0);
    neighbors[3] = (upY < height) ? float4(_Input[uint2(x, upY)].xyz, 1.0) : float4(0, 0, 0, 0.0);
}

void GetNeighborsMoore(uint2 id, out float4 neighbors[8])
{
    int width = _FieldSize.x;
    int height = _FieldSize.y;
    int x = (int) id.x;
    int y = (int) id.y;

    // Вычисляем смещения координат
    int leftX = x - 1;
    int rightX = x + 1;
    int downY = y - 1;
    int upY = y + 1;

    // Проверяем границы и сразу упаковываем: xyz = данные, w = валидность (1 или 0)
    neighbors[0] = (leftX >= 0) ? float4(_Input[uint2(leftX, y)].xyz, 1.0) : float4(0, 0, 0, 0.0);
    neighbors[1] = (rightX < width) ? float4(_Input[uint2(rightX, y)].xyz, 1.0) : float4(0, 0, 0, 0.0);
    neighbors[2] = (downY >= 0) ? float4(_Input[uint2(x, downY)].xyz, 1.0) : float4(0, 0, 0, 0.0);
    neighbors[3] = (upY < height) ? float4(_Input[uint2(x, upY)].xyz, 1.0) : float4(0, 0, 0, 0.0);
    neighbors[4] = (leftX >= 0 && upY < height) ? float4(_Input[uint2(leftX, upY)].xyz, 1.0) : float4(0, 0, 0, 0.0);
    neighbors[5] = (rightX < width && upY < height) ? float4(_Input[uint2(rightX, upY)].xyz, 1.0) : float4(0, 0, 0, 0.0);
    neighbors[6] = (rightX < width && downY >= 0) ? float4(_Input[uint2(rightX, downY)].xyz, 1.0) : float4(0, 0, 0, 0.0);
    neighbors[7] = (leftX >= 0 && downY >= 0) ? float4(_Input[uint2(leftX, downY)].xyz, 1.0) : float4(0, 0, 0, 0.0);
}

void GetNeighborsMooreLoop(uint2 id, out float4 neighbors[8])
{
    int width = _FieldSize.x;
    int height = _FieldSize.y;
    int x = (int) id.x;
    int y = (int) id.y;

    // Вычисляем смещения координат
    int leftX  = (x == 0)          ? (width - 1)  : (x - 1);
    int rightX = (x == width - 1)  ? (0)          : (x + 1);
    int downY  = (y == 0)          ? (height - 1) : (y - 1);
    int upY    = (y == height - 1) ? (0)          : (y + 1);

    // Проверяем границы и сразу упаковываем: xyz = данные, w = валидность (1 или 0)
    neighbors[0] = (leftX >= 0) ? float4(_Input[uint2(leftX, y)].xyz, 1.0) : float4(0, 0, 0, 0.0);
    neighbors[1] = (rightX < width) ? float4(_Input[uint2(rightX, y)].xyz, 1.0) : float4(0, 0, 0, 0.0);
    neighbors[2] = (downY >= 0) ? float4(_Input[uint2(x, downY)].xyz, 1.0) : float4(0, 0, 0, 0.0);
    neighbors[3] = (upY < height) ? float4(_Input[uint2(x, upY)].xyz, 1.0) : float4(0, 0, 0, 0.0);
    neighbors[4] = (leftX >= 0 && upY < height) ? float4(_Input[uint2(leftX, upY)].xyz, 1.0) : float4(0, 0, 0, 0.0);
    neighbors[5] = (rightX < width && upY < height) ? float4(_Input[uint2(rightX, upY)].xyz, 1.0) : float4(0, 0, 0, 0.0);
    neighbors[6] = (rightX < width && downY >= 0) ? float4(_Input[uint2(rightX, downY)].xyz, 1.0) : float4(0, 0, 0, 0.0);
    neighbors[7] = (leftX >= 0 && downY >= 0) ? float4(_Input[uint2(leftX, downY)].xyz, 1.0) : float4(0, 0, 0, 0.0);
}


[numthreads(8, 8, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    if ((int) id.x >= _FieldSize.x || (int) id.y >= _FieldSize.y)
        return;
    
    _Cumulative[id.xy] += float4(saturate(_Input[id.xy].r) * _CumulativeRatio, 0.0, _Input[id.xy].b, 0.0);
    
    float pos = _Input[id.xy].x;
    float vel = _Input[id.xy].y;
    float mass = _Input[id.xy].z;
    if (mass < 0.0)
    {
        _Output[id.xy] = float4(pos, vel, mass, 0.0);
        return;
    }
    float4 neighbors[NEI_COUNT];
    GetNeighborsFN(id.xy, neighbors);
    
    for (int i = 0; i < NEI_COUNT; i++)
    {
        if (neighbors[i].w > 0.0)
        {              
            vel += (((neighbors[i].x - pos) * _Stiffness) / mass) * _DeltaTime;
        }
    }

    uint distToEdgeX = min(id.x, (uint) _FieldSize.x - 1 - id.x);
    uint distToEdgeY = min(id.y, (uint) _FieldSize.y - 1 - id.y);
    float minDist = (float) min(distToEdgeX, distToEdgeY);
    float normalizedDist = saturate(1.0 - (minDist / BORDER));
    float dampingFactor = 1.0 - (normalizedDist * normalizedDist * ABSORPTION_STR);
    vel *= saturate(dampingFactor);
    pos += vel * _DeltaTime;
    _Output[id.xy] = float4(pos, vel, mass, 0.0);
}

#pragma kernel CSInit

RWTexture2D<float4> ResultTexture;
float Seed;

// Простая хэш-функция для генерации псевдослучайного числа [0.0 - 1.0]
float Hash21(float2 p)
{
    p = frac(p * float2(123.34, 456.21));
    p += dot(p, p + 45.32);
    return frac(p.x * p.y);
}

// Функция возвращает 1.0, если мы внутри круга, и 0.0, если снаружи
float getCircleMask(uint x, uint y, float x0, float y0, float R)
{
    float dx = (float)x - x0;
    float dy = (float)y - y0;
    return step(dx * dx + dy * dy, R * R);
}

// Функция возвращает 1.0, если мы внутри прямоугольника, и 0.0, если снаружи
float getRectangleMask(uint x, uint y, float x0, float y0, float width, float height)
{
    float fx = (float)x;
    float fy = (float)y;
    float mask = step(x0, fx) *          // x >= rectLeft
                 step(fx, x0 + width - 1) *   // x <= rectRight
                 step(y0, fy) *          // y >= rectBottom
                 step(fy, y0 + height - 1);  // y <= rectTop

    return mask;
}

void addCircle(uint3 id, float x0, float y0, float R, float pos, float mass, inout float4 result)
{
    result = lerp(result, float4(pos, 0.0, mass, 1.0), getCircleMask(id.x, id.y, x0, y0, R));
}

void addRectangle(uint3 id, float x0, float y0, float width, float height, float pos, float mass, inout float4 result)
{
    result = lerp(result, float4(pos, 0.0, mass, 1.0), getRectangleMask(id.x, id.y, x0, y0, width, height));
}

[numthreads(8, 8, 1)]
void CSInit(uint3 id : SV_DispatchThreadID)
{
    float randomVal = Hash21(id.xy + Seed);
    float4 currentPixel = float4(0.0, 0.0, 1.0, 1.0);
    
    uint xSize;
    uint ySize;
    ResultTexture.GetDimensions(xSize, ySize);
    float halfX = xSize / 2.0;
    float halfY = ySize / 2.0;
    float cirX = halfX * 0.5;
    float cirY = halfY;
    
    //addCircle(id, cirX, cirY, 1, 1.0, 1.0, currentPixel);
    addRectangle(id, cirX, cirY - 30.0, 1.0, 60.0, 1.0, 1.0, currentPixel);
    float gap = 3.0;
    float spacer = 15.0;
    addRectangle(id, cirX + 20.0, cirY + 0.5 * spacer + gap, 1.0, (float) ySize, 0.0, -1.0, currentPixel);
    addRectangle(id, cirX + 20.0, 0.0, 1.0, cirY - 0.5 * spacer - gap, 0.0, -1.0, currentPixel);
    addRectangle(id, cirX + 20.0, cirY - 0.5 * spacer, 1.0, spacer, 0.0, -1.0, currentPixel);
    
    ResultTexture[id.xy] = currentPixel;
}


#pragma kernel CSFindBounds

Texture2D<float4> SourceTexture;
RWStructuredBuffer<int> boundsBuffer;

[numthreads(8, 8, 1)]
void CSFindBounds(uint3 id : SV_DispatchThreadID)
{
    float val = SourceTexture[id.xy].r;
    
    // Переводим во временный int для атомарной операции (умножаем на точность)
    int intVal = (int) (val * 1000.0f);

    // Безопасное параллельное сравнение по всей видеокарте
    InterlockedMin(boundsBuffer[0], intVal);
    InterlockedMax(boundsBuffer[1], intVal);
}